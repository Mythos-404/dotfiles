{
  # VSCode 内置
  "merge-conflict.diffViewPosition" = "Beside";
  "references.preferredLocation" = "view";
  "settingsSync.keybindingsPerPlatform" = false;

  # Terminal（去掉 windows profile/defaultProfile）
  "terminal.integrated.gpuAcceleration" = "on";
  "terminal.integrated.smoothScrolling" = true;
  "terminal.integrated.stickyScroll.enabled" = false;

  # Git
  "git.confirmSync" = false;

  # search
  "search.defaultViewMode" = "tree";
  "search.smartCase" = true;

  # notebook
  "notebook.cellToolbarVisibility" = "hover";
  "notebook.consolidatedRunButton" = true;
  "notebook.globalToolbarShowLabel" = "never";
  "notebook.insertToolbarLocation" = "notebookToolbar";
  "notebook.lineNumbers" = "on";

  # hexeditor
  "hexeditor.columnWidth" = 32;
  "hexeditor.showDecodedText" = true;
  "hexeditor.defaultEndianness" = "little";
  "hexeditor.inspectorType" = "aside";

  "backgroundCover.opacity" = 0.2;

  # Copilot / Chat
  "github.copilot.nextEditSuggestions.enabled" = true;
  "github.copilot.chat.localeOverride" = "zh-CN";
  "chat.agent.maxRequests" = 100;
  "chat.tools.terminal.autoApprove" = {
    "cargo run" = true;
    "cargo test" = true;
  };

  # 其他
  "frosted-glass-theme.fakeMica.enabled" = true;
  "rainbow_csv.enable_context_menu_head" = true;
  "rainbow_csv.enable_context_menu_tail" = true;
  "evenBetterToml.formatter.alignEntries" = true;
  "vscode-edge-devtools.webhint" = false;
  "redhat.telemetry.enabled" = true;

  "editor.formatOnSave" = true;
}
