{
  # 字体
  "debug.console.fontFamily" = "Maple Mono NF CN";
  "editor.fontFamily" = "Maple Mono NF CN";
  "terminal.integrated.fontFamily" = "Maple Mono NF CN";
  "editor.fontLigatures" = true;
  "editor.fontSize" = 16;
  "terminal.integrated.fontSize" = 14;

  # 差异编辑器
  "diffEditor.codeLens" = true;
  "diffEditor.diffAlgorithm" = "advanced";
  "diffEditor.maxComputationTime" = 0;

  # 编辑
  "editor.acceptSuggestionOnEnter" = "off";
  "editor.cursorBlinking" = "phase";
  "editor.cursorSmoothCaretAnimation" = "on";
  "editor.cursorSurroundingLines" = 10;
  "editor.formatOnPaste" = true;
  "editor.formatOnType" = true;
  "editor.guides.bracketPairs" = true;
  "editor.guides.bracketPairsHorizontal" = true;
  "editor.inlayHints.enabled" = "on";
  "editor.inlineSuggest.enabled" = true;
  "editor.lineNumbers" = "relative";
  "editor.linkedEditing" = true;
  "editor.renderLineHighlight" = "all";
  "editor.smoothScrolling" = true;
  "editor.stickyScroll.enabled" = true;
  "editor.suggest.preview" = true;
  "editor.suggest.snippetsPreventQuickSuggestions" = false;
  "editor.suggestSelection" = "recentlyUsedByPrefix";
  "editor.tabCompletion" = "on";
  "editor.quickSuggestions" = {
    "other" = true;
    "comments" = true;
    "strings" = true;
  };

  # 窗口/工作台
  "window.menuBarVisibility" = "compact";
  "window.titleBarStyle" = "custom";
  "window.title" = "\${remotName}\${separator}Mythos_404\${separator}\${profileName}\${separator}\${rootNameShort}";

  "workbench.editor.defaultBinaryEditor" = "hexEditor.hexedit";
  "workbench.editor.empty.hint" = "hidden";
  "workbench.editor.highlightModifiedTabs" = true;
  "workbench.editor.splitInGroupLayout" = "vertical";
  "workbench.editor.tabSizing" = "fixed";
  "workbench.editor.wrapTabs" = true;
  "workbench.iconTheme" = "material-icon-theme";
  "workbench.layoutControl.enabled" = false;
  "workbench.list.smoothScrolling" = true;
  "workbench.productIconTheme" = "bootstrap-product-icons";
  "workbench.tree.renderIndentGuides" = "always";

  "workbench.colorCustomizations" = {
    "menu.background" = "#2e333b70";
    "menu.selectionBackground" = "#4247509a";
    "editorWidget.background" = "#51586320";
    "quickInput.background" = "#2e333b00";
  };

  "workbench.colorTheme" = "Material Theme Ocean";
  "workbench.startupEditor" = "none";

  # 图标主题相关
  "material-icon-theme.hidesExplorerArrows" = false;
}
